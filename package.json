{
  "name": "simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gs8": "tsc -b && vite build && node scripts/check-bundle-budget.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri:dev": "echo 'Install Rust + @tauri-apps/cli, then run: npx tauri dev' && exit 1",
    "tauri:build": "echo 'Install Rust + @tauri-apps/cli, then run: npx tauri build' && exit 1",
    "build:ph-lab-offline": "npm --prefix ph-laboratory-scenery run build",
    "build:ecology-offline": "npm --prefix ecology-scenery run build",
    "build:ph-ecology-offline": "npm --prefix ph-ecology-scenery run build",
    "build:carbon-offline": "npm --prefix ph-carbon-oxygen-scenery run build",
    "build:pyramid-offline": "npm --prefix ph-ecological-pyramid-scenery run build",
    "build:predator-offline": "npm --prefix ph-predator-prey-scenery run build",
    "build:nervous-offline": "npm --prefix nervous-scenery run build",
    "build:heredity-offline": "npm --prefix heredity-scenery run build",
    "build:biotech-offline": "npm --prefix biotech-scenery run build",
    "build:periodic-offline": "npm --prefix periodic-scenery run build",
    "build:reactions-offline": "npm --prefix reactions-scenery run build",
    "build:acids-offline": "npm --prefix acids-scenery run build",
    "build:forces-offline": "npm --prefix forces-scenery run build",
    "build:light-offline": "npm --prefix light-scenery run build",
    "build:electricity-offline": "npm --prefix electricity-scenery run build",
    "build:tech-offline": "npm --prefix tech-scenery run build",
    "build:universe-offline": "npm --prefix universe-scenery run build"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "dexie": "^4.4.4",
    "i18next": "^26.3.6",
    "konva": "^10.3.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.11",
    "react-konva": "^19.2.5",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.14"
