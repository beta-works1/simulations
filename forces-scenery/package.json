{
  "name": "forces-scenery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "title": "Force and Pressure Simulations",
  "author": "SimLab",
  "scripts": {
    "dev": "FORCES_SIM=balanced-unbalanced-forces vite",
    "dev:balanced": "FORCES_SIM=balanced-unbalanced-forces vite",
    "dev:float": "FORCES_SIM=floating-sinking vite",
    "dev:pressure": "FORCES_SIM=pressure-force-area vite",
    "dev:hydraulic": "FORCES_SIM=hydraulic-lift vite",
    "dev:water": "FORCES_SIM=water-pressure-depth vite",
    "build": "node ./scripts/build-all.mjs",
    "build:one": "tsc --noEmit && vite build && node ./scripts/copy-one.mjs",
    "preview": "vite preview"
  },
  "dependencies": { "scenerystack": "^3.0.0" },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.1.0",
    "vite-raw-plugin": "^1.0.2"
  }
}
